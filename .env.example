APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token
DATABASE_URL=postgresql+psycopg://unibiz:unibiz@postgres:5432/unibiz
CORS_ORIGINS=http://localhost:8001
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
WEBHOOK_ENCRYPTION_KEY=replace-with-a-fernet-key
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
MAX_REQUEST_BODY_BYTES=2097152
TRUSTED_HOSTS=localhost,127.0.0.1
